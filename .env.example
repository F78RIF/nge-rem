# ─────────────────────────────────────────────────────────────
# NGE-REM — contoh environment variables
# Salin ke .env.local (lokal) dan isi di Vercel → Settings → Environment Variables.
# JANGAN commit .env.local. JANGAN kirim secret lewat chat/dokumen (Blueprint Bab 52).
# ─────────────────────────────────────────────────────────────

# URL aplikasi (dipakai untuk redirect magic link / reset password)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) atau legacy "anon" key. Aman untuk browser; dilindungi RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret key (sb_secret_...) atau legacy "service_role" key.
# SERVER ONLY — melewati RLS. Tanpa prefix NEXT_PUBLIC_ agar tidak pernah terkirim ke browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
